<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="Athan Watch"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">
        
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WatchMainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service disabled to prevent background Wear OS sync -->
        <service
            android:name=".WearDataListenerService"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <!-- Listen for data events -->
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <!-- Listen for message events -->
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/athan_sync" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/athan_notification" />
            </intent-filter>
        </service>
    </application>
</manifest>
